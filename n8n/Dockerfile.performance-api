# Pin the local base tag to the image currently used by efa-n8n. The deployment
# procedure creates that tag from the running image; it does not pull or upgrade n8n.
ARG N8N_BASE_IMAGE=efa-n8n-base:2.32.7-local
FROM ${N8N_BASE_IMAGE}

USER root
COPY --chown=node:node n8n/custom-nodes/n8n-nodes-ozon-performance /opt/efa-custom-nodes/n8n-nodes-ozon-performance
USER node

# The extension is read-only in the image. NODE_PATH exposes the exact runtime
# n8n-workflow dependency from the pinned base image without npm installation.
ENV N8N_CUSTOM_EXTENSIONS=/opt/efa-custom-nodes/n8n-nodes-ozon-performance
ENV NODE_PATH=/usr/local/lib/node_modules:/usr/local/lib/node_modules/n8n/node_modules
