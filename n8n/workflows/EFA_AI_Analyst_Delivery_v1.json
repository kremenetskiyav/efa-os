{
  "id": "EFAANALYSTEMAIL",
  "name": "EFA AI Analyst Email",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "Sanitised canonical export. Runtime destinations and Gmail/Telegram credentials remain only in n8n.",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [260, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "efa-ai-analyst-email",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "efa-ai-analyst-email"
    },
    {
      "id": "gmail",
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [520, 220],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "__AI_ANALYST_EMAIL_RECIPIENT__",
        "subject": "={{ $json.body.subject }}",
        "emailType": "html",
        "message": "={{ $json.body.html }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "send-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [520, 400],
      "onError": "continueRegularOutput",
      "retryOnFail": false,
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/sendMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "telegramBotPathApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: '__TELEGRAM_CHAT_ID__', text: $json.body.text } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {"node": "Send Email", "type": "main", "index": 0},
          {"node": "Send Telegram", "type": "main", "index": 0}
        ]
      ]
    }
  }
}
