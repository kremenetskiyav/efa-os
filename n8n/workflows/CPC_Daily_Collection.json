      {
        "parameters":{"jsCode":"const work = $items('Build CPC Worklist')[0].json;\nconst reportUuid = $items('Generate CPC Daily Report')[0].json.UUID;\nif (!reportUuid || !$json || typeof $json !== 'object') throw new Error('CPC report payload is incomplete');\nreturn [{json:{collection_ref:`cpc-day-${work.business_date}`,collected_at:new Date().toISOString(),business_date:work.business_date,report_uuid:reportUuid,campaigns:work.campaigns,report:$json,persist:true}}];"},
