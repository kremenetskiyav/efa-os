      {
        "parameters":{"jsCode":"const input = $input.all().map((item) => item.json);\nconst first = input[0];\nconst source = input.length > 1 ? input : (Array.isArray(first) ? first : (first.list ?? first.campaigns ?? []));\nconst campaigns = source.filter((item) => item && item.advObjectType === 'SKU');\nif (!campaigns.length) throw new Error('No CPC/SKU campaigns returned');\nconst ids = campaigns.map((item) => Number(item.id));\nif (ids.some((id) => !Number.isInteger(id))) throw new Error('CPC campaign ID contract mismatch');\nconst business_date = $now.setZone('Europe/Moscow').minus({days:1}).toISODate();\nreturn [{json:{campaigns,campaign_ids:ids.join(','),business_date}}];"},
