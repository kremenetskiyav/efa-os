      {"parameters":{"jsCode":"const input = $input.all().map((item) => item.json);\nconst first = input[0];\nconst source = input.length > 1 ? input : (Array.isArray(first) ? first : (first.list ?? first.campaigns ?? []));\nconst campaigns = source.filter((item) => item && item.advObjectType === 'SKU');\nif (!campaigns.length) throw new Error('No CPC/SKU campaigns returned');\nconst ids = campaigns.map((item) => Number(item.id));\nif (ids.some((id) => !Number.isInteger(id))) throw new Error('CPC campaign ID contract mismatch');\nconst target = $items('Build CPC Target')[0].json;\nreturn [{json:{campaigns,campaign_ids:ids.join(','),business_date:target.business_date,collection_ref:target.collection_ref}}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1200,-80],"id":"10c13cf3-862f-4d9e-bb52-d102516649bd","name":"Build CPC Worklist"},
