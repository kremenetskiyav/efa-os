            { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
            { "type": "null" }
          ]
        },
        "logistic_return_units": {
          "anyOf": [
            { "type": "number" },
            { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
            { "type": "null" }
