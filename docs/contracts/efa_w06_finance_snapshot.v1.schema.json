          "$ref": "#/$defs/entity"
        },
        {
          "type": "object",
          "required": [
            "efa_sku",
            "ozon_sku",
            "commercial_role",
            "financial_gate"
          ],
          "properties": {
            "efa_sku": {
              "enum": [
                "УФ 001Б",
                "УФ 002Б",
                "УФ 003Б",
                "УФ 004Б",
                "УФ 005Б"
              ]
            },
            "ozon_sku": {
              "enum": [
                4601821825,
                4642158029,
                4671345564,
                4642180551,
                4671328307
              ]
            },
